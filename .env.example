# Copy this file to .env  (never commit .env)

# --- Option 1 (recommended, free tier): Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Optional: GEMINI_MODEL=gemini-3.8-flash

# --- Option 2: Anthropic Claude ---
# ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional: GHEE_MODEL=claude-haiku-5-5

# Optional: force a provider when both keys are set (gemini | anthropic)
# LLM_PROVIDER=gemini
# Optional: turn off the AI layer of upload/comment moderation (rule checks stay on)
# GHEE_MODERATION=off
